#!/bin/sh

# CS631 APUE HTTP Server - Sample CGI Script

echo "Content-Type: text/html; charset=utf-8"
echo ""

echo "<!DOCTYPE html>"
echo "<html>"
echo "<head>"
echo "  <meta charset=\"utf-8\">"
echo "  <title>CGI Execution Test</title>"
echo "  <style>"
echo "    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; background: #0f172a; color: #f8fafc; padding: 40px; margin: 0; }"
echo "    .card { background: #1e293b; border-radius: 8px; border: 1px solid #334155; padding: 24px; max-width: 700px; margin: 0 auto; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.5); }"
echo "    h1 { color: #38bdf8; margin-top: 0; font-size: 24px; }"
echo "    p { color: #cbd5e1; line-height: 1.6; }"
echo "    table { width: 100%; border-collapse: collapse; margin-top: 20px; font-size: 14px; }"
echo "    th { text-align: left; padding: 8px 12px; border-bottom: 2px solid #334155; color: #94a3b8; }"
echo "    td { padding: 8px 12px; border-bottom: 1px solid #334155; }"
echo "    .var { color: #f59e0b; font-family: monospace; font-weight: bold; }"
echo "    .val { color: #34d399; font-family: monospace; word-break: break-all; }"
echo "    .badge { display: inline-block; padding: 4px 10px; border-radius: 9999px; background: #0369a1; color: #e0f2fe; font-size: 12px; font-weight: bold; margin-bottom: 15px; }"
echo "  </style>"
echo "</head>"
echo "<body>"
echo "  <div class=\"card\">"
echo "    <div class=\"badge\">CGI 1.1 Process</div>"
echo "    <h1>CGI Script Invocation Succeeded!</h1>"
echo "    <p>This dynamic response was executed via <code>fork()</code>, <code>pipe()</code>, <code>dup2()</code>, and <code>execve()</code> by <strong>cs631-httpd</strong>.</p>"
echo "    <table>"
echo "      <thead><tr><th>Environment Variable</th><th>Value</th></tr></thead>"
echo "      <tbody>"
echo "        <tr><td class=\"var\">REQUEST_METHOD</td><td class=\"val\">${REQUEST_METHOD:-N/A}</td></tr>"
echo "        <tr><td class=\"var\">QUERY_STRING</td><td class=\"val\">${QUERY_STRING:-&lt;empty&gt;}</td></tr>"
echo "        <tr><td class=\"var\">SERVER_PROTOCOL</td><td class=\"val\">${SERVER_PROTOCOL:-N/A}</td></tr>"
echo "        <tr><td class=\"var\">SERVER_SOFTWARE</td><td class=\"val\">${SERVER_SOFTWARE:-N/A}</td></tr>"
echo "        <tr><td class=\"var\">SCRIPT_NAME</td><td class=\"val\">${SCRIPT_NAME:-N/A}</td></tr>"
echo "        <tr><td class=\"var\">PATH_INFO</td><td class=\"val\">${PATH_INFO:-N/A}</td></tr>"
echo "        <tr><td class=\"var\">REMOTE_ADDR</td><td class=\"val\">${REMOTE_ADDR:-N/A}</td></tr>"
echo "        <tr><td class=\"var\">GATEWAY_INTERFACE</td><td class=\"val\">${GATEWAY_INTERFACE:-N/A}</td></tr>"
echo "      </tbody>"
echo "    </table>"
echo "  </div>"
echo "</body>"
echo "</html>"
